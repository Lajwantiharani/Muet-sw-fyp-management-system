<footer style="background-color: transparent; text-align:center; font-size:12px; color:#666;">
    <p style="color:#666; margin:0px; margin-inline: 20px; padding-inline:30px; padding-top: 20px;">
        <%= footerText %>
    </p>

    <p style="margin:0; padding-top:10px; padding-bottom: 5px;">Need assistance? Contact us:</p>
    <p style="margin:0; padding:10px; padding-top: 0px;">
        <a href="tel:<%= supportPhone || '' %>" style="color:#2563EB; text-decoration:none;">
            <%= supportPhone || '' %>
        </a> |
        <a href="mailto:<%= supportEmail  || '' %>" style="color:#2563EB; text-decoration:none;">
            <%= supportEmail || '' %>
        </a> |
        <a href="<%= clientBaseUrl || '' %>" style="color:#2563EB; text-decoration:none;">
            <%= clientBaseUrl || '' %>
        </a>
    </p>
</footer>